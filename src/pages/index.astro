---
import { ArrowDown, ArrowUpRight, Search, SlidersHorizontal, X, Wrench } from '@lucide/astro';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { portfolio } from '../config';
import { sortProjects } from '../lib/projects';
const projects = sortProjects(await getCollection('projects', ({ data }) => !data.draft));
const categories = [...new Set(projects.map((project) => project.data.category))];
---
<Layout>
  <section class="opening-hero" aria-labelledby="intro-title">
    {portfolio.hero.image && <img class="hero-backdrop" src={portfolio.hero.image} alt="" role="presentation" width="1200" height="800" loading="eager" fetchpriority="high" />}
    <div class="hero-inner container">
      <div class="hero-copy">
        <div class="eyebrow"><span class="tiny-line"></span> {portfolio.title}</div>
        <h1 id="intro-title">{portfolio.name}<span class="accent">.</span></h1>
        <p class="hero-focus">{portfolio.hero.focus}</p>
        <p class="hero-description">{portfolio.introduction}</p>
        <div class="hero-actions">
          <a class="button button-dark" href="#work">View projects <ArrowDown size={18} aria-hidden="true" /></a>
          <a class="text-link" href="/about/">About me <ArrowUpRight size={18} aria-hidden="true" /></a>
        </div>
      </div>
      <div class="hero-foot">
        <span>Independent electronics projects</span>
        <a class="text-link" href="#work">Explore the work <ArrowDown size={16} aria-hidden="true" /></a>
      </div>
    </div>
  </section>
  <section id="work" class="work-section container" aria-labelledby="work-title">
    <div class="section-heading">
      <div class="section-title"><h2 id="work-title">Projects</h2><span class="count-pill">{String(projects.length).padStart(2, '0')}</span></div>
    </div>
    <div class="catalog-controls" data-catalog-controls hidden>
      <div class="category-filters" role="group" aria-label="Filter projects by discipline">
        <button class="filter-button is-active" data-filter="All" aria-pressed="true"><SlidersHorizontal size={14} aria-hidden="true" /> All projects</button>
        {categories.map((category) => <button class="filter-button" data-filter={category} aria-pressed="false">{category}</button>)}
      </div>
      <div class="search-field">
        <Search size={17} aria-hidden="true" />
        <label class="sr-only" for="project-search">Search projects</label>
        <input id="project-search" type="search" placeholder="Search projects..." autocomplete="off" />
        <button class="search-clear icon-button" data-clear-search hidden aria-label="Clear search" title="Clear search"><X size={15} aria-hidden="true" /></button>
      </div>
    </div>
    <p class="sr-only" data-result-count role="status" aria-live="polite">{projects.length} projects</p>
    <div class="project-grid" data-project-grid>
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
    <div class="empty-state" data-empty-state hidden>
      <Search size={28} aria-hidden="true" />
      <h3>No projects found</h3>
      <p>Try a different search or discipline.</p>
      <button class="button button-dark" data-reset-filters>Clear filters <X size={16} aria-hidden="true" /></button>
    </div>
    {projects.length === 0 && <div class="empty-state"><Wrench size={28} aria-hidden="true" /><h3>Something new is taking shape.</h3><p>Projects will be here soon.</p></div>}
  </section>
</Layout>
<style>
  .opening-hero { --hero-overlay-opacity: .55; position: relative; isolation: isolate; background: #101214; border-bottom: 1px solid var(--line); }
  .hero-backdrop { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 55%; z-index: -2; }
  .opening-hero::before { content: ''; position: absolute; inset: 0; background: rgb(11 14 16 / var(--hero-overlay-opacity)); z-index: -1; }
  .hero-inner { min-height: min(740px, calc(100svh - 190px)); padding-top: 64px; padding-bottom: 26px; display: flex; flex-direction: column; justify-content: space-between; gap: 54px; }
  .hero-copy { padding-block: 24px; }
  .hero-copy .eyebrow { color: var(--accent); font-size: 12px; }
  .hero-copy h1 { font-size: 96px; font-weight: 700; line-height: 1.05; margin: 24px 0 18px; max-width: 100%; overflow-wrap: anywhere; }
  .hero-focus { font-size: 24px; line-height: 1.5; color: #d0d7da; }
  .hero-description { max-width: 580px; font-size: 18px; line-height: 1.85; color: #c2ccd0; margin-top: 26px; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 32px; margin-top: 32px; }
  .hero-actions .button { min-height: 50px; font-size: 14px; padding-inline: 22px; gap: 24px; }
  .hero-actions .button:hover { background: #a0ddce; }
  .hero-actions .text-link { min-height: 48px; font-size: 14px; }
  .hero-foot { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-top: 22px; border-top: 1px solid #ffffff29; font-size: 12px; color: #c2ccd0; }
  .hero-foot .text-link { font-size: 12px; }
  .opening-hero + .work-section { padding-top: 36px; }
  @media (max-width: 1100px) {
    .hero-copy h1 { font-size: 76px; }
  }
  @media (max-width: 800px) {
    .hero-inner { padding-top: 40px; gap: 36px; }
    .hero-copy h1 { font-size: 64px; }
    .hero-focus { font-size: 21px; }
    .hero-description { font-size: 16px; }
  }
  @media (max-width: 600px) {
    .hero-inner { min-height: calc(100svh - 180px); padding-top: 26px; padding-bottom: 22px; gap: 30px; }
    .hero-copy { padding-block: 12px; }
    .hero-copy .eyebrow { font-size: 10px; }
    .hero-copy h1 { font-size: 48px; margin-top: 22px; }
    .hero-focus { max-width: 340px; font-size: 20px; }
    .hero-description { margin-top: 20px; font-size: 15px; line-height: 1.8; }
    .hero-actions { gap: 24px; margin-top: 26px; }
    .hero-foot { align-items: start; font-size: 10px; gap: 14px; }
    .hero-foot > span { max-width: 130px; }
    .hero-foot .text-link { font-size: 11px; white-space: nowrap; }
    .opening-hero + .work-section { padding-top: 26px; }
  }
</style>
<script>
  import { matchesProject } from '../lib/filter.mjs';
  const controls = document.querySelector<HTMLElement>('[data-catalog-controls]');
  const search = document.querySelector<HTMLInputElement>('#project-search');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project]')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const empty = document.querySelector<HTMLElement>('[data-empty-state]');
  const count = document.querySelector<HTMLElement>('[data-result-count]');
  const clear = document.querySelector<HTMLButtonElement>('[data-clear-search]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');
  let category = 'All';
  if (controls && search && empty && count && clear && grid) {
    controls.hidden = false;
    const params = new URLSearchParams(location.search);
    const requestedCategory = params.get('category');
    if (requestedCategory && buttons.some((button) => button.dataset.filter === requestedCategory)) category = requestedCategory;
    search.value = params.get('q') ?? '';
    const update = () => {
      let visible = 0;
      cards.forEach((card) => {
        const matches = matchesProject({ category: card.dataset.category ?? '', search: card.dataset.search ?? '' }, category, search.value);
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      buttons.forEach((button) => {
        const active = button.dataset.filter === category;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      empty.hidden = visible !== 0;
      clear.hidden = search.value.length === 0;
      grid.classList.toggle('is-filtered', category !== 'All' || search.value.trim().length > 0);
      count.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'} found`;
      const url = new URL(location.href);
      if (category === 'All') url.searchParams.delete('category'); else url.searchParams.set('category', category);
      if (search.value.trim()) url.searchParams.set('q', search.value.trim()); else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    };
    buttons.forEach((button) => button.addEventListener('click', () => { category = button.dataset.filter ?? 'All'; update(); }));
    search.addEventListener('input', update);
    clear.addEventListener('click', () => { search.value = ''; update(); search.focus(); });
    document.querySelector('[data-reset-filters]')?.addEventListener('click', () => { category = 'All'; search.value = ''; update(); search.focus(); });
    update();
  }
</script>