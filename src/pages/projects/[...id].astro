---
import { ArrowLeft, ArrowRight, ArrowUpRight, CirclePlay, Clock, CalendarDays } from '@lucide/astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { sortProjects } from '../../lib/projects';
export async function getStaticPaths() {
  const projects = sortProjects(await getCollection('projects', ({ data }) => !data.draft));
  return projects.map((project, index) => ({ params: { id: project.id }, props: { project, next: projects[(index + 1) % projects.length] } }));
}
interface Props { project: CollectionEntry<'projects'>; next: CollectionEntry<'projects'> }
const { project, next } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const sections = headings.filter((heading) => heading.depth === 2);
---
<Layout title={data.title} description={data.summary} image={data.image}>
  <article class="case-study container">
    <a class="back-link text-link" href="/#work"><ArrowLeft size={16} aria-hidden="true" /> All projects</a>
    <header class="case-header">
      <div class="eyebrow">{data.category}{data.year && <><span class="separator">/</span>{data.year}</>}{data.status && <><span class="separator">/</span>{data.status}</>}</div>
      <h1>{data.title}</h1>
      <p class="case-summary">{data.summary}</p>
      <ul class="project-tags">{data.tags.map((tag) => <li>{tag}</li>)}</ul>
    </header>
    {data.image && <figure class="case-image"><img src={data.image} alt={data.imageAlt} width="1600" height="1067" fetchpriority="high" style={`object-position: ${data.imagePosition}`} />{data.demo && <figcaption>Illustrative sample image. This project is a demonstration case study.</figcaption>}</figure>}
    {data.demo && <aside class="sample-notice">Sample project, not a record of completed work. Project details and imagery are placeholders.</aside>}
    {data.outcomes.length > 0 && <div class="outcomes">{data.outcomes.map((outcome) => <div><strong>{outcome.value}</strong><span>{outcome.label}</span></div>)}</div>}
    <div class="case-body">
      <aside class="case-sidebar" aria-label="Project details">
        <dl class="project-facts">
          {data.duration && <div><dt><Clock size={15} aria-hidden="true" /> Timeline</dt><dd>{data.duration}</dd></div>}
          {data.year && <div><dt><CalendarDays size={15} aria-hidden="true" /> Year</dt><dd>{data.year}</dd></div>}
          {data.tools.length > 0 && <div><dt>Toolbox</dt><dd class="toolbox">{data.tools.map((tool) => <span>{tool}</span>)}</dd></div>}
        </dl>
        {data.links.length > 0 && <div class="project-resources">{data.links.map((link) => <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<ArrowUpRight size={16} aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>)}</div>}
        {sections.length > 0 && <nav class="case-toc" aria-label="On this page"><h2>In this project</h2>{sections.map((section) => <a href={`#${section.slug}`}>{section.text}</a>)}</nav>}
      </aside>
      <div class="prose">
        <Content />
        {data.gallery.length > 0 && <div class="process-gallery" aria-label="Build photographs">
          {data.gallery.map((photo) => <figure><img src={photo.src} alt={photo.alt} width="1600" height="1000" loading="lazy" /><figcaption>{photo.caption}</figcaption></figure>)}
        </div>}
        {(data.video || data.videoPoster) && <figure class="case-video">
          {data.video ? <video controls playsinline preload="metadata" src={data.video} poster={data.videoPoster} aria-label={data.videoCaption} width="1600" height="900">Your browser does not support embedded video. <a href={data.video}>Download the video</a>.</video> :
            <div class="video-placeholder"><img src={data.videoPoster} alt={`${data.title} demonstration video placeholder`} width="1600" height="1000" loading="lazy" /><div><CirclePlay size={42} aria-hidden="true" /><span>Video placeholder</span></div></div>}
          <figcaption>{data.videoCaption}</figcaption>
        </figure>}
      </div>
    </div>
    {next.id !== project.id && <a class="next-project" href={`/projects/${next.id}/`}><div><span class="eyebrow">Next project</span><h2>{next.data.title}</h2></div><ArrowRight size={30} aria-hidden="true" /></a>}
  </article>
</Layout>